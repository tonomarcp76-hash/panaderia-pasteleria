<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🍞 Panadería y Pastelería - POS</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; font-family: Arial, sans-serif; }
        body { background: #fef6e9; color: #5a3e2b; min-height: 100vh; }
        .container { max-width: 1200px; margin: 0 auto; padding: 20px; }
        header { background: #8b5a2b; color: white; padding: 20px; text-align: center; border-radius: 10px; margin-bottom: 20px; }
        .seccion { background: white; padding: 20px; border-radius: 10px; margin-bottom: 20px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        h2 { color: #8b5a2b; margin-bottom: 15px; border-bottom: 2px solid #f0d4b5; padding-bottom: 8px; }
        button { background: #8b5a2b; color: white; border: none; padding: 10px 15px; border-radius: 5px; cursor: pointer; margin: 5px; font-size: 14px; }
        button:hover { background: #6d4422; }
        button.rojo { background: #c0392b; }
        button.rojo:hover { background: #a02a1c; }
        input, select { padding: 8px; border: 1px solid #d4b89b; border-radius: 5px; margin: 5px; width: 100%; max-width: 300px; }
        .grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(250px, 1fr)); gap: 15px; }
        .producto { background: #fdf2e4; padding: 12px; border-radius: 8px; border-left: 4px solid #8b5a2b; }
        .carrito-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px dashed #ddd; }
        .total { font-size: 22px; font-weight: bold; text-align: right; margin-top: 15px; color: #8b5a2b; }
        .ticket { background: #fff; border: 1px dashed #888; padding: 20px; margin-top: 20px; font-family: monospace; font-size: 13px; display: none; }
        .fila-ticket { display: flex; justify-content: space-between; padding: 2px 0; }
        .auth-box { max-width: 400px; margin: 100px auto; }
        .oculto { display: none !important; }
        .mensaje { padding: 10px; border-radius: 5px; margin: 10px 0; display: none; }
        .exito { background: #d4edda; color: #155724; display: block; }
        .error { background: #f8d7da; color: #721c24; display: block; }
    </style>
</head>
<body>

<!-- 🔐 INICIO DE SESIÓN -->
<div id="seccion-auth" class="seccion auth-box">
    <h2 style="text-align: center;">🥐 Iniciar Sesión</h2>
    <div id="mensaje-auth" class="mensaje"></div>
    <div>
        <label>Usuario:</label><br>
        <input type="text" id="usuario" placeholder="Escribe tu usuario">
    </div>
    <div>
        <label>Contraseña:</label><br>
        <input type="password" id="contrasena" placeholder="Escribe tu contraseña">
    </div>
    <br>
    <button onclick="iniciarSesion()">🔑 Entrar</button>
    <button onclick="mostrarRegistro()">📝 Registrarse</button>
</div>

<!-- 📝 REGISTRO -->
<div id="seccion-registro" class="seccion auth-box oculto">
    <h2 style="text-align: center;">📝 Nuevo Usuario</h2>
    <div id="mensaje-reg" class="mensaje"></div>
    <div>
        <label>Usuario:</label><br>
        <input type="text" id="nuevo-usuario" placeholder="Nombre de usuario">
    </div>
    <div>
        <label>Contraseña:</label><br>
        <input type="password" id="nueva-pass" placeholder="Contraseña">
    </div>
    <div>
        <label>Confirmar contraseña:</label><br>
        <input type="password" id="confirma-pass" placeholder="Repite tu contraseña">
    </div>
    <br>
    <button onclick="registrarUsuario()">✅ Crear cuenta</button>
    <button onclick="cerrarRegistro()">← Volver</button>
</div>

<!-- 🛒 SISTEMA PRINCIPAL -->
<div id="sistema" class="oculto">
    <header>
        <h1>🥖 PANADERÍA Y PASTELERÍA</h1>
        <p>Bienvenido, <span id="nombre-usuario"></span> | <button style="background:#5a3e2b; padding:5px 10px; font-size:12px;" onclick="cerrarSesion()">Cerrar sesión</button></p>
    </header>

    <div class="container">
        <!-- 📋 PRODUCTOS -->
        <div class="seccion">
            <h2>📋 Lista de Productos</h2>
            <div class="grid" id="lista-productos"></div>
        </div>

        <!-- 🛒 CARRITO -->
        <div class="seccion">
            <h2>🛒 Carrito</h2>
            <div id="carrito-vacio">El carrito está vacío</div>
            <div id="items-carrito"></div>
            <div class="total">Total: $<span id="total">0.00</span></div>
            <br>
            <button onclick="limpiarCarrito()" class="rojo">🗑️ Cancelar Venta</button>
            <button onclick="cobrar()">💳 Cobrar y Generar Ticket</button>
        </div>

        <!-- 🧾 TICKET -->
        <div class="seccion ticket" id="ticket">
            <h3 style="text-align:center;">PANADERÍA Y PASTELERÍA</h3>
            <p style="text-align:center;">Calle Ejemplo 123, CDMX<br>Tel: 55-1234-5678</p>
            <hr>
            <p>Ticket Nº: <span id="t-num"></span></p>
            <p>Fecha: <span id="t-fecha"></span></p>
            <p>Cajero: <span id="t-cajero"></span></p>
            <hr>
            <div id="t-items"></div>
            <hr>
            <p class="fila-ticket"><strong>TOTAL: $<span id="t-total"></span></strong></p>
            <p class="fila-ticket">Pago con: $<span id="t-pago"></span></p>
            <p class="fila-ticket">Cambio: $<span id="t-cambio"></span></p>
            <hr>
            <p style="text-align:center;">¡Gracias por su compra!<br>Vuelva pronto</p>
            <br>
            <button onclick="window.print()">🖨️ Imprimir Ticket</button>
        </div>
    </div>
</div>

<script>
// ================== DATOS ==================
const productos = [
    { codigo: "PAN001", nombre: "Concha", precio: 12.00, categoria: "Panadería" },
    { codigo: "PAN002", nombre: "Cuernito", precio: 10.00, categoria: "Panadería" },
    { codigo: "PAN003", nombre: "Oreja", precio: 10.00, categoria: "Panadería" },
    { codigo: "PAN004", nombre: "Bolillo", precio: 6.00, categoria: "Panadería" },
    { codigo: "PAN005", nombre: "Telera", precio: 7.00, categoria: "Panadería" },
    { codigo: "PAN006", nombre: "Roles de Canela", precio: 15.00, categoria: "Panadería" },
    { codigo: "PAN007", nombre: "Empanada de Piña", precio: 12.00, categoria: "Panadería" },
    { codigo: "PAN008", nombre: "Empanada de Carne", precio: 15.00, categoria: "Panadería" },
    { codigo: "PAS001", nombre: "Rebanada Pastel 3 Leches", precio: 55.00, categoria: "Pastelería" },
    { codigo: "PAS002", nombre: "Rebanada Pastel Chocolate", precio: 50.00, categoria: "Pastelería" },
    { codigo: "PAS003", nombre: "Rebanada Pastel Fresa", precio: 48.00, categoria: "Pastelería" },
    { codigo: "PAS004", nombre: "Pay de Queso Rebanada", precio: 45.00, categoria: "Pastelería" },
    { codigo: "PAS005", nombre: "Pastel Completo 3 Leches", precio: 550.00, categoria: "Pastelería" },
    { codigo: "PAS006", nombre: "Gelatina Individual", precio: 25.00, categoria: "Pastelería" },
    { codigo: "PAS007", nombre: "Mousse de Limón", precio: 35.00, categoria: "Pastelería" }
];

let carrito = [];
let usuarioActivo = null;
let numeroTicket = 1;

// ================== USUARIOS ==================
function obtenerUsuarios() {
    return JSON.parse(localStorage.getItem('usuarios') || '{}');
}

function guardarUsuarios(usuarios) {
    localStorage.setItem('usuarios', JSON.stringify(usuarios));
}

function mostrarRegistro() {
    document.getElementById('seccion-auth').classList.add('oculto');
    document.getElementById('seccion-registro').classList.remove('oculto');
}

function cerrarRegistro() {
    document.getElementById('seccion-registro').classList.add('oculto');
    document.getElementById('seccion-auth').classList.remove('oculto');
}

function registrarUsuario() {
    const usuario = document.getElementById('nuevo-usuario').value.trim();
    const pass = document.getElementById('nueva-pass').value;
    const confirma = document.getElementById('confirma-pass').value;
    const msg = document.getElementById('mensaje-reg');
    const usuarios = obtenerUsuarios();
    
    if (!usuario || usuario.length < 3) {
        msg.textContent = "⚠️ El usuario debe tener al menos 3 caracteres";
        msg.className = "mensaje error";
        return;
    }
    if (pass.length < 4) {
        msg.textContent = "⚠️ La contraseña debe tener al menos 4 caracteres";
        msg.className = "mensaje error";
        return;
    }
    if (pass !== confirma) {
        msg.textContent = "⚠️ Las contraseñas no coinciden";
        msg.className = "mensaje error";
        return;
    }
    if (usuarios[usuario]) {
        msg.textContent = "⚠️ Ese nombre de usuario ya existe";
        msg.className = "mensaje error";
        return;
    }
    
    usuarios[usuario] = pass;
    guardarUsuarios(usuarios);
    msg.textContent = "✅ Usuario creado con éxito. ¡Inicia sesión!";
    msg.className = "mensaje exito";
    setTimeout(cerrarRegistro, 1500);
}

function iniciarSesion() {
    const usuario = document.getElementById('usuario').value.trim();
    const pass = document.getElementById('contrasena').value;
    const msg = document.getElementById('mensaje-auth');
    const usuarios = obtenerUsuarios();
    
    if (!Object.keys(usuarios).length) {
        msg.textContent = "⚠️ No hay usuarios registrados. Regístrate primero.";
        msg.className = "mensaje error";
        return;
    }
    
    if (usuarios[usuario] && usuarios[usuario] === pass) {
        usuarioActivo = usuario;
        document.getElementById('nombre-usuario').textContent = usuario;
        document.getElementById('seccion-auth').classList.add('oculto');
        document.getElementById('sistema').classList.remove('oculto');
        cargarProductos();
    } else {
        msg.textContent = "❌ Usuario o contraseña incorrectos";
        msg.className = "mensaje error";
    }
}

function cerrarSesion() {
    usuarioActivo = null;
    carrito = [];
    document.getElementById('sistema').classList.add('oculto');
    document.getElementById('seccion-auth').classList.remove('oculto');
    document.getElementById('ticket').style.display = 'none';
}

// ================== PRODUCTOS ==================
function cargarProductos() {
    const contenedor = document.getElementById('lista-productos');
    contenedor.innerHTML = '';
    
    productos.forEach(prod => {
        contenedor.innerHTML += `
            <div class="producto">
                <strong>${prod.nombre}</strong><br>
                <small>${prod.categoria}</small><br>
                <strong>$${prod.precio.toFixed(2)}</strong><br>
                <button onclick="agregarAlCarrito('${prod.codigo}')">➕ Agregar</button>
            </div>
        `;
    });
}

// ================== CARRITO ==================
function agregarAlCarrito(codigo) {
    const prod = productos.find(p => p.codigo === codigo);
    const existente = carrito.find(c => c.codigo === codigo);
    
    if (existente) {
        existente.cantidad++;
    } else {
        carrito.push({ ...prod, cantidad: 1 });
    }
    actualizarCarrito();
}

function actualizarCarrito() {
    const contenedor = document.getElementById('items-carrito');
    const vacio = document.getElementById('carrito-vacio');
    const totalEl = document.getElementById('total');
    
    if (carrito.length === 0) {
        vacio.style.display = 'block';
        contenedor.innerHTML = '';
        totalEl.textContent = '0.00';
        return;
    }
    
    vacio.style.display = 'none';
    contenedor.innerHTML = '';
    let total = 0;
    
    carrito.forEach((item, idx) => {
        const subtotal = item.precio * item.cantidad;
        total += subtotal;
        contenedor.innerHTML += `
            <div class="carrito-item">
                <span>${item.cantidad}x ${item.nombre}</span>
                <span>$${subtotal.toFixed(2)} <button style="padding:2px 5px; font-size:10px;" onclick="quitarDelCarrito(${idx})">✕</button></span>
            </div>
        `;
    });
    
    totalEl.textContent = total.toFixed(2);
}

function quitarDelCarrito(idx) {
    carrito[idx].cantidad--;
    if (carrito[idx].cantidad <= 0) carrito.splice(idx, 1);
    actualizarCarrito();
}

function limpiarCarrito() {
    carrito = [];
    actualizarCarrito();
    document.getElementById('ticket').style.display = 'none';
}

// ================== COBRAR Y TICKET ==================
function cobrar() {
    if (carrito.length === 0) {
        alert("⚠️ El carrito está vacío");
        return;
    }
    
    const total = carrito.reduce((sum, i) => sum + i.precio * i.cantidad, 0);
    const recibido = parseFloat(prompt(`Total a pagar: $${total.toFixed(2)}\nEfectivo recibido: $`));
    
    if (isNaN(recibido) || recibido < total) {
        alert("⚠️ Cantidad inválida");
        return;
    }
    
    const cambio = recibido - total;
    const fecha = new Date().toLocaleString('es-MX');
    
    // Mostrar ticket
    document.getElementById('t-num').textContent = String(numeroTicket).padStart(4, '0');
    document.getElementById('t-fecha').textContent = fecha;
    document.getElementById('t-cajero').textContent = usuarioActivo;
    document.getElementById('t-total').textContent = total.toFixed(2);
    document.getElementById('t-pago').textContent = recibido.toFixed(2);
    document.getElementById('t-cambio').textContent = cambio.toFixed(2);
    
    const itemsTicket = document.getElementById('t-items');
    itemsTicket.innerHTML = '';
    carrito.forEach(item => {
        itemsTicket.innerHTML += `
            <p class="fila-ticket">
                <span>${item.cantidad}x ${item.nombre}</span>
                <span>$${(item.precio * item.cantidad).toFixed(2)}</span>
            </p>
        `;
    });
    
    document.getElementById('ticket').style.display = 'block';
    numeroTicket++;
    carrito = [];
    actualizarCarrito();
}

// Verificar si hay usuarios al cargar
window.onload = function() {
    const usuarios = obtenerUsuarios();
    if (Object.keys(usuarios).length === 0) {
        document.getElementById('mensaje-auth').textContent = "ℹ️ No hay cuentas. Regístrate como primer usuario.";
        document.getElementById('mensaje-auth').className = "mensaje exito";
    }
};
</script>

</body>
</html>
