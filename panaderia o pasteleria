<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>🍞 POS - Panadería & Pastelería</title>
    <style>
        *{margin:0;padding:0;box-sizing:border-box;font-family:Arial,sans-serif;}
        body{background:#fdf6e3;padding:20px;max-width:1000px;margin:0 auto;}
        h1{text-align:center;background:#8b4513;color:white;padding:20px;border-radius:8px;margin-bottom:20px;}
        
        .menu{display:flex;justify-content:center;gap:8px;margin-bottom:20px;flex-wrap:wrap;}
        .btn-menu{padding:10px 16px;border:none;border-radius:6px;font-size:14px;cursor:pointer;background:#d2691e;color:white;transition:all 0.2s;}
        .btn-menu.activo{background:#27ae60;transform:scale(1.05);}
        .btn-menu:hover{opacity:0.9;}
        
        .pagina{display:none;background:white;padding:25px;border-radius:8px;box-shadow:0 2px 8px #0002;}
        .pagina.activa{display:block;}
        h2{color:#8b4513;margin-bottom:20px;text-align:center;}
        
        button{padding:8px 15px;border:none;border-radius:4px;cursor:pointer;font-size:14px;}
        .btn-verde{background:#27ae60;color:white;}
        .btn-rojo{background:#e74c3c;color:white;}
        .btn-azul{background:#3498db;color:white;}
        .btn-naranja{background:#f39c12;color:white;}
        button:hover{opacity:0.85;}
        
        table{width:100%;border-collapse:collapse;margin:15px 0;}
        th,td{padding:10px;text-align:left;border-bottom:1px solid #ddd;}
        th{background:#8b4513;color:white;}
        
        .total{text-align:right;font-size:24px;font-weight:bold;color:#27ae60;margin-top:15px;}
        .acciones{text-align:center;margin-top:20px;}
        .vacio{text-align:center;color:#888;padding:30px;}
        
        .etiqueta-cat{
            display:inline-block;padding:3px 8px;border-radius:12px;font-size:12px;color:white;
        }
        .cat-pan{background:#deb887;}
        .cat-pastel{background:#ff69b4;}
        .cat-galleta{background:#f0e68c;color:#333;}
        .cat-bebida{background:#87ceeb;color:#333;}
        .cat-otro{background:#cd853f;}
    </style>
</head>
<body>

    <h1>🍞 POS - Panadería & Pastelería 🎂</h1>

    <div class="menu">
        <button class="btn-menu activo" id="btn-ventas" onclick="mostrarPagina('ventas')">🧾 Ventas</button>
        <button class="btn-menu" id="btn-productos" onclick="mostrarPagina('productos')">📦 Productos</button>
        <button class="btn-menu" id="btn-compras" onclick="mostrarPagina('compras')">📥 Entradas de Mercancía</button>
        <button class="btn-menu" id="btn-reportes" onclick="mostrarPagina('reportes')">📊 Reportes</button>
        <button class="btn-menu" id="btn-cierre" onclick="mostrarPagina('cierre')">🔒 Cierre de Caja</button>
    </div>

    <!-- ====== VENTAS ====== -->
    <div id="ventas" class="pagina activa">
        <h2>🧾 Nueva Venta</h2>
        <button class="btn-verde" onclick="agregarItem()">➕ Agregar Producto</button>
        <table>
            <thead>
                <tr><th>Producto</th><th>Cantidad</th><th>Unidad</th><th>Precio</th><th>Subtotal</th><th>Eliminar</th></tr>
            </thead>
            <tbody id="cuerpoVenta"></tbody>
        </table>
        <div class="total">Total: $<span id="totalVenta">0.00</span></div>
        <div class="acciones">
            <button class="btn-rojo" onclick="limpiarVenta()">🗑️ Limpiar</button>
            <button class="btn-verde" onclick="cobrar()">✅ Cobrar</button>
        </div>
    </div>

    <!-- ====== PRODUCTOS ====== -->
    <div id="productos" class="pagina">
        <h2>📦 Inventario de Productos</h2>
        <button class="btn-verde" onclick="agregarProducto()">➕ Nuevo Producto</button>
        <table>
            <thead>
                <tr><th>Nombre</th><th>Categoría</th><th>Precio Venta</th><th>Stock</th><th>Unidad</th><th>Acciones</th></tr>
            </thead>
            <tbody id="cuerpoProductos"></tbody>
        </table>
    </div>

    <!-- ====== COMPRAS / ENTRADAS ====== -->
    <div id="compras" class="pagina">
        <h2>📥 Entradas de Mercancía</h2>
        <button class="btn-verde" onclick="agregarCompra()">➕ Registrar Entrada</button>
        <table>
            <thead>
                <tr><th>Fecha</th><th>Producto</th><th>Cantidad</th><th>Costo Unitario</th><th>Total</th></tr>
            </thead>
            <tbody id="cuerpoCompras">
                <tr><td colspan="5" class="vacio">No hay entradas registradas</td></tr>
            </tbody>
        </table>
    </div>

    <!-- ====== REPORTES ====== -->
    <div id="reportes" class="pagina">
        <h2>📊 Reportes</h2>
        <div style="display:grid;gap:15px;margin:20px 0;">
            <div style="background:#fff3cd;padding:20px;border-radius:8px;">
                <h3>💰 Ventas del Día</h3>
                <p style="font-size:28px;font-weight:bold;color:#27ae60;margin-top:10px;">$<span id="rep-ventasDia">0.00</span></p>
            </div>
            <div style="background:#d4edda;padding:20px;border-radius:8px;">
                <h3>📈 Total Ventas (Acumulado)</h3>
                <p style="font-size:28px;font-weight:bold;color:#27ae60;margin-top:10px;">$<span id="rep-totalVentas">0.00</span></p>
            </div>
            <div style="background:#e3f2fd;padding:20px;border-radius:8px;">
                <h3>📦 Productos Activos</h3>
                <p style="font-size:28px;font-weight:bold;color:#3498db;margin-top:10px;"><span id="rep-totalProductos">0</span></p>
            </div>
            <div style="background:#fce4ec;padding:20px;border-radius:8px;">
                <h3>📥 Inversión / Compras</h3>
                <p style="font-size:28px;font-weight:bold;color:#e91e63;margin-top:10px;">$<span id="rep-totalCompras">0.00</span></p>
            </div>
        </div>
        <div class="acciones">
            <button class="btn-azul" onclick="actualizarReportes()">🔄 Actualizar</button>
        </div>
    </div>

    <!-- ====== CIERRE DE CAJA ====== -->
    <div id="cierre" class="pagina">
        <h2>🔒 Cierre de Caja</h2>
        <div style="font-size:18px;line-height:2.2;">
            <p><strong>Fecha:</strong> <span id="fecha"></span></p>
            <p><strong>Ventas realizadas hoy:</strong> <span id="ventasHoy">0</span></p>
            <p><strong>Total vendido hoy:</strong> $<span id="totalHoy">0.00</span></p>
            <p><strong>Total en Caja:</strong> $<span id="cajaTotal">0.00</span></p>
            <hr style="margin:15px 0;border:none;border-top:2px dashed #ddd;">
            <p style="font-size:20px;"><strong>Saldo Final:</strong> <span style="color:#27ae60;font-weight:bold;font-size:26px;">$<span id="saldoFinal">0.00</span></span></p>
        </div>
        <div class="acciones">
            <button class="btn-naranja" onclick="cerrarParcial()">📌 Cierre Parcial</button>
            <button class="btn-rojo" onclick="cerrarCajaTotal()">🔒 Cierre Total</button>
        </div>
    </div>

<script>
// ===== CATEGORÍAS DE PANADERÍA =====
const categorias = ["Pan Dulce", "Pan Salado", "Pasteles", "Galletas", "Bebidas", "Otros"];
const unidades = ["pieza", "kg", "docena", "media docena", "caja", "litro"];

// ===== DATOS =====
let productos = JSON.parse(localStorage.getItem('misProductos')) || [];
let compras = JSON.parse(localStorage.getItem('misCompras')) || [];
let carrito = [];
let totalCaja = parseFloat(localStorage.getItem('totalCaja')) || 0;
let totalVentasAcumulado = parseFloat(localStorage.getItem('totalVentasAcumulado')) || 0;
let ventasHoy = parseInt(localStorage.getItem('ventasHoy')) || 0;
let totalVentaDia = parseFloat(localStorage.getItem('totalVentaDia')) || 0;

// ===== FECHA =====
document.getElementById('fecha').textContent = new Date().toLocaleDateString('es-MX',{
    weekday:'long',year:'numeric',month:'long',day:'numeric'
});

// ===== INICIALIZAR =====
actualizarTablaProductos();
actualizarTablaCompras();
actualizarReportes();
actualizarCierre();

// ===== CAMBIAR PÁGINA =====
function mostrarPagina(nombre){
    document.querySelectorAll('.btn-menu').forEach(boton => boton.classList.remove('activo'));
    document.querySelectorAll('.pagina').forEach(pagina => pagina.classList.remove('activa'));
    document.getElementById('btn-' + nombre).classList.add('activo');
    document.getElementById(nombre).classList.add('activa');
    if(nombre === 'reportes') actualizarReportes();
    if(nombre === 'cierre') actualizarCierre();
}

// ===== OBTENER CLASE DE CATEGORÍA =====
function claseCategoria(cat){
    switch(cat){
        case "Pan Dulce": case "Pan Salado": return "etiqueta-cat cat-pan";
        case "Pasteles": return "etiqueta-cat cat-pastel";
        case "Galletas": return "etiqueta-cat cat-galleta";
        case "Bebidas": return "etiqueta-cat cat-bebida";
        default: return "etiqueta-cat cat-otro";
    }
}

// ====== PRODUCTOS ======
function agregarProducto(){
    let nombre = prompt('Nombre del producto:\nEj: Concha, Bolillo, Pastel de Chocolate...');
    if(!nombre) return;
    
    let catLista = categorias.map((c,i) => `${i+1}. ${c}`).join('\n');
    let catIdx = parseInt(prompt(`Categoría:\n${catLista}`)) - 1;
    if(isNaN(catIdx) || catIdx < 0 || catIdx >= categorias.length) return;
    let categoria = categorias[catIdx];
    
    let precio = parseFloat(prompt('Precio de venta por unidad:'));
    if(isNaN(precio) || precio <= 0){alert('Precio inválido');return;}
    
    let costo = parseFloat(prompt('Costo de producción/compra:')) || 0;
    
    let uniLista = unidades.map((u,i) => `${i+1}. ${u}`).join('\n');
    let uniIdx = parseInt(prompt(`Unidad de venta:\n${uniLista}`)) - 1;
    if(isNaN(uniIdx) || uniIdx < 0 || uniIdx >= unidades.length) return;
    let unidad = unidades[uniIdx];
    
    let stock = parseFloat(prompt(`Cantidad en inventario (en ${unidad}):`));
    if(isNaN(stock) || stock < 0){alert('Cantidad inválida');return;}
    
    productos.push({nombre, categoria, precio, costo, stock, unidad});
    guardarProductos();
    actualizarTablaProductos();
    alert(`✅ Producto agregado:\n${nombre} — ${categoria}\n$${precio.toFixed(2)} / ${unidad}`);
}

function guardarProductos(){
    localStorage.setItem('misProductos', JSON.stringify(productos));
}

function actualizarTablaProductos(){
    let cuerpo = document.getElementById('cuerpoProductos');
    cuerpo.innerHTML = '';
    if(productos.length === 0){
        cuerpo.innerHTML = '<tr><td colspan="6" class="vacio">No hay productos registrados</td></tr>';
        return;
    }
    productos.forEach((p, i) => {
        cuerpo.innerHTML += `
            <tr>
                <td><strong>${p.nombre}</strong></td>
                <td><span class="${claseCategoria(p.categoria)}">${p.categoria}</span></td>
                <td>$${p.precio.toFixed(2)}</td>
                <td>${p.stock}</td>
                <td>${p.unidad}</td>
                <td><button class="btn-rojo" onclick="eliminarProducto(${i})">Eliminar</button></td>
            </tr>
        `;
    });
}

function eliminarProducto(i){
    if(confirm('¿Eliminar este producto del inventario?')){
        productos.splice(i, 1);
        guardarProductos();
        actualizarTablaProductos();
    }
}

// ====== COMPRAS / ENTRADAS ======
function agregarCompra(){
    if(productos.length === 0){alert('Primero registra productos');return;}
    let lista = productos.map((p, i) => `${i+1}. ${p.nombre} — ${p.categoria}`).join('\n');
    let idx = parseInt(prompt('Selecciona producto:\n'+lista)) - 1;
    if(isNaN(idx) || idx < 0 || idx >= productos.length) return;
    
    let cant = parseFloat(prompt(`Cantidad recibida (en ${productos[idx].unidad}):`));
    if(isNaN(cant) || cant <= 0){alert('Cantidad inválida');return;}
    
    let costo = parseFloat(prompt('Costo unitario:'));
    if(isNaN(costo) || costo <= 0){alert('Costo inválido');return;}
    
    productos[idx].stock += cant;
    guardarProductos();
    
    let fecha = new Date().toLocaleDateString('es-MX');
    compras.unshift({fecha, nombre: productos[idx].nombre, cantidad: cant, unidad: productos[idx].unidad, costo: costo, total: cant * costo});
    localStorage.setItem('misCompras', JSON.stringify(compras));
    
    actualizarTablaCompras();
    actualizarReportes();
    alert(`✅ Entrada registrada:\n+${cant} ${productos[idx].unidad} de ${productos[idx].nombre}`);
}

function actualizarTablaCompras(){
    let cuerpo = document.getElementById('cuerpoCompras');
    cuerpo.innerHTML = '';
    if(compras.length === 0){
        cuerpo.innerHTML = '<tr><td colspan="5" class="vacio">No hay entradas registradas</td></tr>';
        return;
    }
    compras.forEach(c => {
        cuerpo.innerHTML += `
            <tr>
                <td>${c.fecha}</td>
                <td>${c.nombre}</td>
                <td>${c.cantidad} ${c.unidad || ''}</td>
                <td>$${c.costo.toFixed(2)}</td>
                <td>$${c.total.toFixed(2)}</td>
            </tr>
        `;
    });
}

// ====== VENTAS ======
function agregarItem(){
    if(productos.length === 0){alert('Primero registra productos');return;}
    let lista = productos.map((p, i) => `${i+1}. ${p.nombre} — $${p.precio.toFixed(2)} / ${p.unidad}`).join('\n');
    let idx = parseInt(prompt('Selecciona producto:\n'+lista)) - 1;
    if(isNaN(idx) || idx < 0 || idx >= productos.length) return;
    
    let cant = parseFloat(prompt(`Cantidad a vender (${productos[idx].unidad}):`));
    if(isNaN(cant) || cant <= 0){alert('Cantidad inválida');return;}
    if(cant > productos[idx].stock){alert(`⚠️ Stock insuficiente\nDisponible: ${productos[idx].stock} ${productos[idx].unidad}`);return;}
    
    carrito.push({
        nombre: productos[idx].nombre, 
        cantidad: cant, 
        precio: productos[idx].precio, 
        unidad: productos[idx].unidad,
        indice: idx
    });
    actualizarTablaVenta();
}

function actualizarTablaVenta(){
    let cuerpo = document.getElementById('cuerpoVenta');
    cuerpo.innerHTML = '';
    let total = 0;
    carrito.forEach((item, i) => {
        let subt = item.cantidad * item.precio;
        total += subt;
        cuerpo.innerHTML += `
            <tr>
                <td><strong>${item.nombre}</strong></td>
                <td>${item.cantidad}</td>
                <td>${item.unidad}</td>
                <td>$${item.precio.toFixed(2)}</td>
                <td>$${subt.toFixed(2)}</td>
                <td><button class="btn-rojo" onclick="quitarItem(${i})">X</button></td>
            </tr>
        `;
    });
    document.getElementById('totalVenta').textContent = total.toFixed(2);
}

function quitarItem(i){
    carrito.splice(i, 1);
    actualizarTablaVenta();
}
